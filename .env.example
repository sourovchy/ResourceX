# ResourceX — Environment Variables
# Copy this file to .env and fill in your values.
# This file is committed to Git as a reference. The actual .env is gitignored.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=resourcex
DB_USERNAME=root
DB_PASSWORD=your-db-password-here

JWT_SECRET=your-jwt-secret-here-must-be-at-least-64-characters-long-for-hs256

MAIL_USERNAME=your-email@gmail.com
MAIL_APP_PASSWORD=your-mail-password-here

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — only needed when running with the default (MySQL) profile.
# The 'local' profile uses H2 in-memory and ignores these DB_* values.
# FILE_UPLOAD_DIR=uploads
# SPRING_PROFILES_ACTIVE=local
