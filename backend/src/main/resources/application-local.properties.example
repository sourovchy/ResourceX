# ResourceX — Local Development Profile (H2 In-Memory Database)
# Copy this file to application-local.properties.
# Activate with: -Dspring-boot.run.profiles=local

spring.datasource.url=jdbc:h2:mem:resourcex_local;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

spring.jpa.hibernate.ddl-auto=create-drop
spring.jpa.show-sql=false

# Local profile uses H2 (in-memory). Hibernate creates the schema from entities,
# and the Flyway migrations under db/migration/ contain MySQL-specific DDL that H2
# cannot parse (e.g. V2__suspension_system.sql uses multi-column ADD clauses with
# ADD INDEX / ADD CONSTRAINT in one statement, which H2 rejects with [42000-224]).
# Production (MySQL) keeps Flyway enabled via application.properties.
spring.flyway.enabled=false

# Local-only bootstrap SUPER_ADMIN. Used by LocalAdminBootstrap (Profile("local"))
# to unblock the user-approval workflow on fresh databases. Never executes in
# production because the bean is profile-gated.
app.bootstrap-admin.enabled=true
app.bootstrap-admin.email=admin@resourcex.local
app.bootstrap-admin.password=your-local-admin-password-here
app.bootstrap-admin.name=Local Super Admin
